# DropWatch application environment.
# Copy to .env for local development. Never commit a filled-in copy — the root
# .gitignore covers .env and .env.* so that only this example is tracked.

# --- Required: the server refuses to start in production without these ---

# "development" locally. Anything else — including unset — is treated as
# production, which disables the development-only auth route below.
NODE_ENV=development

# HS256 signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must not be empty: signing throws "Zero-length key is not supported".
JWT_SECRET=

# MySQL connection string, e.g. mysql://user:password@host:3306/dropwatch
# Also read by drizzle-kit for `pnpm db:push`, and by the integration tests,
# which skip themselves entirely when it is absent.
DATABASE_URL=

# Manus OAuth. VITE_APP_ID is compared against the appId inside every session
# token, so a token minted for another app is rejected.
OAUTH_SERVER_URL=
VITE_APP_ID=

# --- Optional: features degrade gracefully when unset ---

# Postmark. Without both of these, threshold emails report status "skipped"
# rather than failing.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# PriceAPI. Without this, price import jobs cannot be queued.
PRICE_API_TOKEN=

# ADR-6: automated price imports are OFF for the MVP, which ships manual price
# logging only. Leave unset. PriceAPI bills per job and cost scales as
# watches x sources with no ceiling, so turning this on has a money cost —
# and it gates the provider callback too, not just the UI. Must be exactly
# "true" to enable.
PRICE_IMPORTS_ENABLED=false

# Object storage proxy behind /manus-storage/*, which requires a session.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# openId of the account treated as the owner.
OWNER_OPEN_ID=

# Absolute URL of the marketing site, linked from the dashboard.
# Defaults to https://www.usedropwatch.com/ when unset.
VITE_LANDING_PAGE_URL=

# --- Development-only ---

# Mints a session for a fixed test user at GET /__test__/session, which
# requires the secret in an x-dropwatch-test-secret header. Only honoured when
# NODE_ENV is exactly "development" or "test"; ignored everywhere else.
DROPWATCH_TEST_AUTH_ENABLED=false
DROPWATCH_TEST_AUTH_SECRET=

# Set to "true" to let provider tests make real network calls.
RUN_LIVE_PROVIDER_TESTS=false

# Local server port. Defaults to 3000, and steps forward if that is busy.
PORT=3000
