# DropWatch application environment.
# Copy to .env for local development. Never commit a filled-in copy — the root
# .gitignore covers .env and .env.* so that only this example is tracked.

# --- Required: the server refuses to start in production without these ---

# "development" locally. Anything else — including unset — is treated as
# production, which disables the development-only auth route below.
NODE_ENV=development

# HS256 signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must not be empty: signing throws "Zero-length key is not supported".
JWT_SECRET=

# Postgres connection string for the dropwatch_app role, e.g.
#   postgresql://dropwatch_app:password@host:5432/dropwatch
# This role is deliberately NOT the table owner, so row-level security binds
# on every query (see drizzle/0001_rls_policies.sql). In production point at
# Supabase's transaction pooler (port 6543); the driver already runs with
# prepare:false to match it. Integration tests skip themselves when unset.
DATABASE_URL=

# Owner/admin connection string, used only for migrations
# (pnpm exec drizzle-kit migrate) and scripts/provision-app-role.mjs — never
# by the running app.
ADMIN_DATABASE_URL=

# Password to assign to the dropwatch_app role via
#   node scripts/provision-app-role.mjs
# (the role itself is created NOLOGIN by the migrations).
APP_DB_PASSWORD=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# The server verifies Supabase Auth access tokens against
# ${SUPABASE_URL}/auth/v1 (JWKS by default).
SUPABASE_URL=

# App identifier baked into session tokens; a session minted for any other
# appId is rejected. Any stable unique string, e.g. "dropwatch".
VITE_APP_ID=

# --- Client (inlined by Vite at build time) ---

# Same project as SUPABASE_URL, plus the publishable (anon) key. Used only on
# the login path (magic-link sign-in); data access is all server-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional: features degrade gracefully when unset ---

# Legacy HS256 verification for Supabase projects without asymmetric signing
# keys. Leave unset for current projects — JWKS is used instead.
SUPABASE_JWT_SECRET=

# Shared secret for the scheduled-imports endpoint (/api/scheduled/*). Vercel
# Cron sends it as "Authorization: Bearer <CRON_SECRET>". When unset, the
# endpoint refuses all callers — safe default while imports stay disabled
# (ADR-6).
CRON_SECRET=

# Postmark. Without both of these, threshold emails report status "skipped"
# rather than failing.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# PriceAPI. Without this, price import jobs cannot be queued.
PRICE_API_TOKEN=

# Anthropic (ADR-4): alert parsing and deal verdicts. Without a key, plain-
# English alert creation falls back to the manual form and verdicts fall back
# to a deterministic sentence. ANTHROPIC_MODEL overrides the default model
# (claude-opus-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Manus forge gateway — now used only by _core/heartbeat.ts and the dead
# vendor surface; both go away with ADR-5/ADR-7.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# openId (Supabase auth user UUID) of the account treated as the owner.
OWNER_OPEN_ID=

# Absolute URL of the marketing site, linked from the dashboard.
# Defaults to https://www.usedropwatch.com/ when unset.
VITE_LANDING_PAGE_URL=

# --- Development-only ---

# Mints a session for a fixed test user at GET /__test__/session, which
# requires the secret in an x-dropwatch-test-secret header. Only honoured when
# NODE_ENV is exactly "development" or "test"; ignored everywhere else.
DROPWATCH_TEST_AUTH_ENABLED=false
DROPWATCH_TEST_AUTH_SECRET=

# Set to "true" to let provider tests make real network calls.
RUN_LIVE_PROVIDER_TESTS=false

# Local server port. Defaults to 3000, and steps forward if that is busy.
PORT=3000

# Connection-pool size for the app's Postgres client (default 10; serverless
# deployments should set 1).
DATABASE_POOL_MAX=
