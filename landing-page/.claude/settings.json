{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f docs/00-status.md ]; then echo '=== Project status (docs/00-status.md) ==='; cat docs/00-status.md; else echo 'No docs/00-status.md yet — fresh template. Start with /new-idea, or copy docs/templates/status.md to docs/00-status.md.'; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm audit:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsc:*)",
      "Bash(ls:*)",
      "Bash(supabase migration list:*)",
      "Bash(supabase db diff:*)"
    ],
    "deny": []
  }
}
